//@version=6
indicator("BTC 历史周期与时间窗口", overlay = true, max_lines_count = 100, max_labels_count = 100)

// 1. 显示设置：适合 BTC 美元现货的日线、周线。
showHistory = input.bool(true, "显示历史周期高低点", group = "显示")
showHalving = input.bool(true, "显示历史减半", group = "显示")
showForecast = input.bool(true, "显示时间推算", group = "显示")
shade = input.bool(true, "给推算阶段的已有K线着色", group = "显示")

// 2. 推算锚点可修改。此日期是已知历史高点，不保证是最终周期顶部。
anchor = input.time(timestamp("06 Oct 2025 00:00 +0000"), "假设的周期顶部", group = "时间模型")
// 历史下跌样本：410、363、376天；上涨样本：1068、1061天。
// 排除早期不成熟市场的上涨样本；这是人为选择，不能视为统计置信区间。
bearMin = input.int(363, "下跌段最短天数", minval = 1, group = "时间模型")
bearMid = input.int(383, "下跌段参考天数", minval = 1, group = "时间模型")
bearMax = input.int(410, "下跌段最长天数", minval = 1, group = "时间模型")
bullMin = input.int(1061, "上涨段最短天数", minval = 1, group = "时间模型")
bullMid = input.int(1065, "上涨段参考天数", minval = 1, group = "时间模型")
bullMax = input.int(1068, "上涨段最长天数", minval = 1, group = "时间模型")
nextHalving = input.time(timestamp("08 Apr 2028 00:00 +0000"), "下次减半估计日期（可更新）", group = "时间模型")

// 3. 使用 UTC 时间和自然日，避免按K线根数计时造成周期变化。
int DAY = 86400000
f_date(int t) => str.format_time(t, "yyyy-MM-dd", "UTC")
f_ts(int y, int m, int d) => timestamp("UTC", y, m, d, 0, 0)
int lowEarly = anchor + bearMin * DAY
int lowMid = anchor + bearMid * DAY
int lowLate = anchor + bearMax * DAY
int topEarly = lowEarly + bullMin * DAY
int topMid = lowMid + bullMid * DAY
int topLate = lowLate + bullMax * DAY
bool valid = bearMin <= bearMid and bearMid <= bearMax and bullMin <= bullMid and bullMid <= bullMax
if barstate.isfirst and not valid
    runtime.error("天数设置必须满足：最短 ≤ 参考 ≤ 最长。")

// 4. 保存绘图对象；最后一根K线更新时先删除旧对象，避免重复堆积。
var array<line> marks = array.new<line>()
var array<label> notes = array.new<label>()
f_mark(int t, float y, string txt, color c, bool dashed) =>
    line ln = line.new(t, y, t, y * 1.01, xloc = xloc.bar_time, extend = extend.both, color = color.new(c, 40), style = dashed ? line.style_dashed : line.style_dotted)
    label lb = label.new(t, y, txt + "\n" + f_date(t), xloc = xloc.bar_time, yloc = yloc.price, color = color.new(c, 15), textcolor = color.white, style = c == color.teal ? label.style_label_up : label.style_label_down, size = size.small)
    array.push(marks, ln)
    array.push(notes, lb)

// 日期固定；价格只用于把文字放在相应历史行情附近，不是精确报价。
var array<int> dates = array.from(f_ts(2011, 6, 8), f_ts(2011, 11, 18), f_ts(2013, 11, 30), f_ts(2015, 1, 14), f_ts(2017, 12, 17), f_ts(2018, 12, 15), f_ts(2021, 11, 10), f_ts(2022, 11, 21), f_ts(2025, 10, 6))
var array<float> levels = array.from(31.9, 2.0, 1163.0, 152.0, 19800.0, 3122.0, 69000.0, 15500.0, 126210.5)
var array<int> halvings = array.from(f_ts(2012, 11, 28), f_ts(2016, 7, 9), f_ts(2020, 5, 11), f_ts(2024, 4, 20))
var array<float> halvingLevels = array.from(12.0, 650.0, 8600.0, 64000.0)
var table panel = table.new(position.top_right, 2, 7, border_width = 1)

if barstate.islast
    for ln in marks
        line.delete(ln)
    for lb in notes
        label.delete(lb)
    array.clear(marks)
    array.clear(notes)
    if showHistory
        for i = 0 to array.size(dates) - 1
            bool isTop = i % 2 == 0
            string title = i == 8 ? "历史最高点 / 候选周期顶部" : isTop ? "历史周期高点" : "历史周期低点"
            if array.get(dates, i) <= timenow
                f_mark(array.get(dates, i), array.get(levels, i), title, isTop ? color.red : color.teal, false)
    if showHalving
        for i = 0 to array.size(halvings) - 1
            f_mark(array.get(halvings, i), array.get(halvingLevels, i) * 1.5, "第" + str.tostring(i + 1) + "次减半", color.orange, true)
    if showForecast
        // 文字的纵坐标仅用于排版，不代表未来目标价。
        float y = close
        f_mark(lowEarly, y * 1.08, "低点窗口开始（估算）", color.teal, true)
        f_mark(lowMid, y * 1.20, "低点参考 / 上涨段起点假设", color.teal, true)
        f_mark(lowLate, y * 1.34, "低点窗口结束（估算）", color.teal, true)
        f_mark(topEarly, y * 1.08, "高点窗口开始（估算）", color.red, true)
        f_mark(topMid, y * 1.20, "高点参考 / 下跌段起点假设", color.red, true)
        f_mark(topLate, y * 1.34, "高点窗口结束（估算）", color.red, true)
        f_mark(nextHalving, y * 1.5, "第五次减半（估计；区块1,050,000）", color.orange, true)
    color bg = color.new(color.black, 15)
    table.cell(panel, 0, 0, "BTC 时间模型", bgcolor = bg, text_color = color.white)
    table.cell(panel, 1, 0, "历史类比，非交易信号", bgcolor = bg, text_color = color.yellow)
    table.cell(panel, 0, 1, "假设顶部", bgcolor = bg, text_color = color.white)
    table.cell(panel, 1, 1, f_date(anchor), bgcolor = bg, text_color = color.white)
    table.cell(panel, 0, 2, "低点窗口", bgcolor = bg, text_color = color.teal)
    table.cell(panel, 1, 2, f_date(lowEarly) + " ~ " + f_date(lowLate), bgcolor = bg, text_color = color.white)
    table.cell(panel, 0, 3, "参考下跌段", bgcolor = bg, text_color = color.white)
    table.cell(panel, 1, 3, f_date(anchor) + " ~ " + f_date(lowMid), bgcolor = bg, text_color = color.white)
    table.cell(panel, 0, 4, "参考上涨段", bgcolor = bg, text_color = color.white)
    table.cell(panel, 1, 4, f_date(lowMid) + " ~ " + f_date(topMid), bgcolor = bg, text_color = color.white)
    table.cell(panel, 0, 5, "下一高点窗口", bgcolor = bg, text_color = color.red)
    table.cell(panel, 1, 5, f_date(topEarly) + " ~ " + f_date(topLate), bgcolor = bg, text_color = color.white)
    table.cell(panel, 0, 6, "数据适用范围", bgcolor = bg, text_color = color.white)
    table.cell(panel, 1, 6, syminfo.basecurrency == "BTC" ? "BTC/USD或USDT；建议日线/周线" : "请切换到BTC美元图表", bgcolor = bg, text_color = color.yellow)

// 5. 仅给已经存在的K线着色；未来日期由竖线标记。
color phaseColor = na
if showForecast and shade
    if time >= anchor and time < lowMid
        phaseColor := color.new(color.red, 93)
    else if time >= lowMid and time < topMid
        phaseColor := color.new(color.teal, 93)
bgcolor(phaseColor, title = "假设的下跌/上涨阶段")

// 6. 统计指定日期以来的最低价格。
// 默认起点：2025年10月6日 UTC零点，可在指标设置中修改。
rangeLowStart = input.time(
    timestamp("06 Oct 2025 00:00 +0000"),
    "最低价统计起点",
    group = "区间最低价"
)

showRangeLow = input.bool(
    true,
    "显示区间最低价",
    group = "区间最低价"
)

// var：保留结果，让后续K线能够继续比较。
// na：尚未找到有效数据。
var float rangeLowPrice = na
var int rangeLowTime = na
var label rangeLowLabel = na

// 按当前图表的K线逐根比较。
// 只有起点之后的K线参与统计。
if time >= rangeLowStart and time <= timenow
    if na(rangeLowPrice)
        rangeLowPrice := low
        rangeLowTime := time
    else if low < rangeLowPrice
        rangeLowPrice := low
        rangeLowTime := time

// 在最后一根K线上更新标签，图中只保留一个。
if barstate.islast
    if not na(rangeLowLabel)
        label.delete(rangeLowLabel)
        rangeLowLabel := na

    if showRangeLow and not na(rangeLowPrice)
        string rangeLowText = "Bottom since " +
             str.format_time(rangeLowStart, "yyyy-MM-dd", "UTC") +
             "\n价格：" + str.tostring(rangeLowPrice, format.mintick) +
             "\n日期：" + str.format_time(rangeLowTime, "yyyy-MM-dd", "UTC")

        rangeLowLabel := label.new(
            x = rangeLowTime,
            y = rangeLowPrice,
            text = rangeLowText,
            xloc = xloc.bar_time,
            yloc = yloc.price,
            style = label.style_label_up,
            color = color.teal,
            textcolor = color.white,
            size = size.normal
        )